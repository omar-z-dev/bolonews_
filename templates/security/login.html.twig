{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}

<div class="login-container">

    <form  class ="login-form" action="{{ path('app_login') }}" method="post">


        {# error est une est une variable envoyée à ce Twig par  SecurityController  #}
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}


        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connexion</h1>


        <label for="username">Email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>


        <label for="password">Mot de passe</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>


        {# Elle protège le formulaire contre une attaque appelée CSRF (Cross-Site Request Forgery).

        la partie srf_token('authenticate')  appelle une fonction Symfony qui génère un token CSRF par exemple fghcghcf5gh45c545445 Cette valeur est aussi enregistrée dans la session de l'utilisateur.

        Lors du clic sur "Sign in" le navigateur envoie ce token au serveur :   _username=omar@gmail.com
                    _password=123456
                    _csrf_token=7b6e0d5f3f1b2c9e8a4d...
                            
        Symfony vérifie le token

        -- le token reçu dans le formulaire ;
        -- la valeur de le token qu'il a enregistré dans la session.

        #}

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}

        <button class=" btn-login se-connecter" type="submit">
            Se connecter
        </button>

        <p class="creer-compte">
            Vous n'avez pas de compte ?
            <a class ="btn-creer-compte" href="{{ path('app_register') }}">
                Créer votre compte
            </a>
        </p>

        <a class="btn-retour" href="{{ path('app_home') }}">
                 Retour
        </a>
    </form>

</div>
{% endblock %}



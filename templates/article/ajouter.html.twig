{% extends 'base.html.twig' %}

{% block title %}
    Ajouter un article
{% endblock %}

{% block body %}

<div class="form-ajouter">

    <h1>Ajouter un article</h1>

    {{ form_start(form) }}

        {{ form_row(form.titre) }}

        {{ form_row(form.contenu) }}

        {{ form_row(form.imageFile) }}

        {{ form_row(form.categorie) }}

        <button class="btn-ajouter form-btn" type="submit">
            Ajouter l’article
        </button>
        <div>
            <a href="{{ path('app_dashboard') }}" class="btn-retour">
                Retour
            </a>
        </div>

    {{ form_end(form) }}

</div>

{% endblock %}